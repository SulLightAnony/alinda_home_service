# =========================================================================
# .gitignore untuk Alinda Home Service (PHP Native / XAMPP)
# =========================================================================

# -------------------------------------------------------------------------
# 1. FILE ARSIP & BACKUP (UKURAN BESAR)
# -------------------------------------------------------------------------
# File arsip/zip menimbun kapasitas repository git dan memperlambat clone/push
*.zip
*.rar
*.tar
*.tar.gz
*.7z
*.bak
*.old

# -------------------------------------------------------------------------
# 2. DATABASE & SQL DUMPS
# -------------------------------------------------------------------------
# Mencegah terunggahnya data riil pengguna, password hash, dan kredensial sensitif
*.sql
*.sqlite
*.sqlite3
*.db
database/sql/*
!database/sql/.gitkeep

# -------------------------------------------------------------------------
# 3. FILE UPLOAD DINAMIS / USER GENERATED CONTENT (UGC)
# -------------------------------------------------------------------------
# Folder 'database/' di projek ini digunakan sebagai media penyimpanan upload.
# File upload dinamis tidak boleh masuk git, tetapi struktur foldernya dipertahankan
# menggunakan .gitkeep dan gambar placeholder default (Default.*).

# Bukti transfer pembayaran (Sensitif data transaksi / rekening)
database/customer/image/transfer/*
!database/customer/image/transfer/.gitkeep

# Bukti pengerjaan & pembatalan transaksi oleh mitra
database/partner/image/finished-image-prove/*
!database/partner/image/finished-image-prove/.gitkeep
database/partner/image/canceled-image-prove/*
!database/partner/image/canceled-image-prove/.gitkeep

# Foto profil customer & partner (Pertahankan Default.jpg & .gitkeep)
database/customer/image/profile/*
!database/customer/image/profile/Default.*
!database/customer/image/profile/.gitkeep

database/partner/image/profile/*
!database/partner/image/profile/Default.*
!database/partner/image/profile/.gitkeep

# Kartu Identitas / KTP partner (Sensitif privasi personal)
database/partner/image/card/*
!database/partner/image/card/Default.*
!database/partner/image/card/.gitkeep

# -------------------------------------------------------------------------
# 4. KREDENSIAL, ENVIRONMENT & SECRETS
# -------------------------------------------------------------------------
# Jangan commit file environment yang berisi password database / API key produksi
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# -------------------------------------------------------------------------
# 5. FILE SAMPAH SISTEM OPERASI (OS ARTIFACTS)
# -------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# -------------------------------------------------------------------------
# 6. TEMPORARY & LOCK FILES (OFFICE / EDITOR)
# -------------------------------------------------------------------------
# Lock file Microsoft Word / Office (contoh: admin/~$README.md)
~$*
*.tmp
*.temp
*~
*.swp
*.swo

# -------------------------------------------------------------------------
# 7. IDE & TEXT EDITOR CONFIGURATIONS
# -------------------------------------------------------------------------
# Konfigurasi workspace lokal editor (VSCode, PhpStorm, Sublime)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# -------------------------------------------------------------------------
# 8. LOGS & CACHE
# -------------------------------------------------------------------------
*.log
logs/
error_log
php_errors.log
.sass-cache/

# -------------------------------------------------------------------------
# 9. DEPENDENCY MANAGERS (FUTURE-PROOF)
# -------------------------------------------------------------------------
# Catatan: Menggunakan '/vendor/' dengan awalan slash agar HANYA folder vendor
# di root projek yang diabaikan jika memakai Composer di masa depan,
# dan TIDAK mengabaikan 'admin/vendor/' (aset Bootstrap/JS bawaan template admin).
/vendor/
node_modules/
